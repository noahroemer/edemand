# Copy to .env and fill in. .env is gitignored - never commit real values.

# EIA API v2 key. Free and instant: https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# Databricks. Prefer ~/.databrickscfg [DEFAULT] locally; set these only in CI.
DATABRICKS_HOST=
DATABRICKS_TOKEN=

# Unity Catalog target. This workspace exposes `workspace` (no `main`) - see CLAUDE.md
# section 13 question 3, which is still unresolved.
UC_CATALOG=workspace
UC_SCHEMA_BRONZE=bronze
UC_SCHEMA_SILVER=silver
UC_SCHEMA_GOLD=gold

# Open-Meteo needs no key.
